# teemoHub local development environment
# Copy to .env and fill in provider keys. Never commit .env.

# --- teemoHub ---
TEEMOHUB_CONTROL_ADDR=127.0.0.1:18080
TEEMOHUB_GATEWAY_ADDR=127.0.0.1:18081
TEEMOHUB_DB_PATH=./runtime/teemohub.db
TEEMOHUB_WEB_DIR=./web/dist
TEEMOHUB_SESSION_SECRET=change-me
TEEMOHUB_ADMIN_USER=admin
TEEMOHUB_ADMIN_PASSWORD=change-me
TEEMOHUB_DEMO_USER=demo
TEEMOHUB_DEMO_PASSWORD=change-me

# --- New API upstream ---
# teemoHub only ever holds a New API user token, not provider keys.
NEWAPI_BASE_URL=http://127.0.0.1:3000
NEWAPI_TOKEN=
NEWAPI_ROOT_USER=root
NEWAPI_ROOT_PASSWORD=TeemoHub!2026

# --- Provider keys (read only by scripts/bootstrap-newapi.sh) ---
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_REASONER_MODEL=deepseek-reasoner

KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.cn
KIMI_MODEL=kimi-k3.1-pro

# --- New API runtime ---
NEWAPI_PORT=3000
NEWAPI_SQLITE_PATH=./runtime/newapi/newapi.db

# --- Gateway behaviour ---
TEEMOHUB_DRAIN_MS=2000
TEEMOHUB_DRAIN_MAX_TOKENS=512
TEEMOHUB_DRAIN_MAX_BYTES=1048576
TEEMOHUB_UPSTREAM_TIMEOUT=10m
